rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function authed() { return request.auth != null; }
    function role() { return (request.auth.token.role != null) ? request.auth.token.role : '';
    }
    function isDevAdmin() { return role() == 'dev_admin'; }
    function isProjectOwner() { return role() == 'project_owner'; }
    function isSubNodal() { return role() == 'sub_nodal'; }
    function isSuperNodal() { return role() == 'super_nodal'; }
    function myUid() { return request.auth.uid; }
    // Normalize common alias variants to a single comparable key
    function _normBlock(b) {
      return (
        b == null ? '' :
        (lower(b) == 'nagari' || lower(b) == 'nagarí') ? 'nagri' :
        (lower(b) == 'dhamtari (town)' || lower(b) == 'dhamtari town') ? 'dhamtari' :
        lower(b)
      );
    }
    function hasBlock(blockId) {
      return (
        (request.auth.token.blockId != null && _normBlock(request.auth.token.blockId) == _normBlock(blockId)) ||
        (request.auth.token.blocks != null && (_normBlock(blockId) in request.auth.token.blocks.map(b, _normBlock(b))))
      );
    }

    // Users: user can read/write own profile; dev admin can read/write all
    match /users/{userId} {
      allow read: if authed() && (userId == myUid() || isDevAdmin());
      allow write: if authed() && (userId == myUid() || isDevAdmin());
      // fcmTokens subcollection: user can manage their tokens
      match /fcmTokens/{token} {
        allow read, write: if authed() && (userId == myUid() || isDevAdmin());
      }
    }

    // Projects collection
    match /projects/{projectId} {
      allow read: if authed() && (
          isDevAdmin() || isSuperNodal() ||
          (isProjectOwner() && resource.data.ownerId == myUid()) ||
          (isSubNodal() && hasBlock(resource.data.blockId))
        );
      allow create: if authed() && (
          isDevAdmin() || (isProjectOwner() && request.resource.data.ownerId == myUid())
        );
      allow update, delete: if authed() && (
          // Full control
          isDevAdmin() || isSuperNodal() ||
          // Owner: limited fields only
          (
            isProjectOwner() && resource.data.ownerId == myUid() &&
            let diff = request.resource.data.diff(resource.data);
            // Only allow updating status, description, workDescription.stage, and updatedAt
            diff.changedKeys().hasOnly(['status','description','workDescription','updatedAt']) &&
            // If workDescription changed, only stage may change within it
            (
              (
                (request.resource.data.workDescription == null && resource.data.workDescription == null) ||
                (
                  (request.resource.data.workDescription == null ? {} : request.resource.data.workDescription)
                    .diff(resource.data.workDescription == null ? {} : resource.data.workDescription)
                    .changedKeys()
                    .hasOnly(['stage'])
                )
              )
            )
          ) ||
          // Sub-nodal: limited fields for projects within their block
          (
            isSubNodal() && hasBlock(resource.data.blockId) &&
            let diff2 = request.resource.data.diff(resource.data);
            diff2.changedKeys().hasOnly(['status','description','workDescription','updatedAt']) &&
            (
              (
                (request.resource.data.workDescription == null && resource.data.workDescription == null) ||
                (
                  (request.resource.data.workDescription == null ? {} : request.resource.data.workDescription)
                    .diff(resource.data.workDescription == null ? {} : resource.data.workDescription)
                    .changedKeys()
                    .hasOnly(['stage'])
                )
              )
            )
          )
        );

      // updates subcollection: align with project doc permissions
      match /updates/{updateId} {
        allow read: if authed() && (
          isDevAdmin() || isSuperNodal() ||
          (isProjectOwner() && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == myUid()) ||
          (isSubNodal() && hasBlock(get(/databases/$(database)/documents/projects/$(projectId)).data.blockId))
        );
        // Allow create by: dev_admin, super_nodal, project_owner, and sub_nodal (within block)
        allow create: if authed() && (
          isDevAdmin() || isSuperNodal() ||
          (isProjectOwner() && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == myUid()) ||
          (isSubNodal() && hasBlock(get(/databases/$(database)/documents/projects/$(projectId)).data.blockId))
        );
        // Allow update/delete by dev_admin, super_nodal, or project owner
        allow update, delete: if authed() && (
          isDevAdmin() || isSuperNodal() || (isProjectOwner() && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == myUid())
        );
      }
    }

    // Notifications: per-user documents
    match /notifications/{notifId} {
      allow read: if authed() && resource.data.userId == myUid();
      // Only allow marking as read by recipient; block creation client-side (server writes via CF)
      allow create: if false;
      allow update: if authed() && resource.data.userId == myUid();
      allow delete: if isDevAdmin();
    }

    // Counters: allow all authenticated users to write to the specific projects counter (used by client txn)
    match /counters/projects {
      allow read: if authed();
      allow write: if authed();
    }
    // Other counters: dev admin only
    match /counters/{doc} {
      allow read: if authed() && (isDevAdmin() || isSuperNodal());
      allow write: if isDevAdmin();
    }
    match /config/{doc} {
      allow read: if authed() && (isDevAdmin() || isSuperNodal());
      allow write: if isDevAdmin();
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
